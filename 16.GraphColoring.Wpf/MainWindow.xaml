<Window x:Class="_16.GraphColoring.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graph Coloring With GA.Core"
        Height="780"
        Width="1240"
        MinHeight="680"
        MinWidth="1060"
        Background="#F6F7F9"
        WindowState="Maximized">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20242A" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Graph Coloring" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Chromosome stores the color index for each node; fitness counts color conflicts" Foreground="#59616D" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Solver parameters" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <TextBlock Text="Dataset" FontWeight="SemiBold" />
                    <ComboBox x:Name="DatasetComboBox" SelectedIndex="1" Margin="0,6,0,14">
                        <ComboBoxItem Content="Map graph" />
                        <ComboBoxItem Content="Dense graph" />
                    </ComboBox>

                    <TextBlock Text="Color count" FontWeight="SemiBold" />
                    <TextBox x:Name="ColorCountTextBox" Text="3" Margin="0,6,0,14" />

                    <TextBlock Text="Population size" FontWeight="SemiBold" />
                    <TextBox x:Name="PopulationSizeTextBox" Text="500" Margin="0,6,0,14" />

                    <TextBlock Text="Maximum generations" FontWeight="SemiBold" />
                    <TextBox x:Name="MaxGenerationsTextBox" Text="800" Margin="0,6,0,14" />

                    <TextBlock Text="Tournament size" FontWeight="SemiBold" />
                    <TextBox x:Name="TournamentSizeTextBox" Text="4" Margin="0,6,0,14" />

                    <TextBlock Text="Elitism rate" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,14">
                        <TextBlock x:Name="ElitismRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="ElitismRateSlider" Minimum="0.01" Maximum="0.40" Value="0.12" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                    </DockPanel>

                    <TextBlock Text="Mutation rate" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,14">
                        <TextBlock x:Name="MutationRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="MutationRateSlider" Minimum="0" Maximum="0.50" Value="0.08" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                    </DockPanel>

                    <TextBlock Text="Generation delay" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="DelayTextBlock" DockPanel.Dock="Right" Width="62" TextAlignment="Right" />
                        <Slider x:Name="DelaySlider" Minimum="0" Maximum="100" Value="6" TickFrequency="1" ValueChanged="ParameterSlider_ValueChanged" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Graph" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Canvas x:Name="GraphCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="GraphCanvas_SizeChanged" />
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Chromosome pool" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="node color x population" DockPanel.Dock="Right" Foreground="#59616D" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border x:Name="ChromosomePoolHost" Grid.Row="1" BorderBrush="#D7DCE2" BorderThickness="1" Background="#FBFCFD" SizeChanged="ChromosomePoolHost_SizeChanged">
                            <Grid>
                                <Image x:Name="ChromosomePoolImage" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SnapsToDevicePixels="True" />
                                <TextBlock x:Name="ChromosomePoolPlaceholderTextBlock"
                                           Text="Press Start to see the chromosome pool."
                                           Foreground="#59616D"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="18" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Population preview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="PopulationListBox" Grid.Row="1" FontFamily="Consolas" BorderBrush="#E5E8EC" Background="#FBFCFD" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Current state" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="Generation" Foreground="#59616D" />
                <TextBlock x:Name="GenerationTextBlock" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Conflict score" Foreground="#59616D" />
                <TextBlock x:Name="BestFitnessTextBlock" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Average score" Foreground="#59616D" />
                <TextBlock x:Name="AverageFitnessTextBlock" Text="-" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Conflicting edges" Foreground="#59616D" />
                <TextBlock x:Name="ConflictEdgesTextBlock" Text="-" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Status" Foreground="#59616D" />
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,18" />

                <TextBlock Text="Representation" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Gene = node color index&#x0a;Fitness = same-color edge count&#x0a;Best possible score = 0&#x0a;Goal = no adjacent equal colors"
                           FontFamily="Consolas"
                           Foreground="#59616D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Fitness over generations" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Rectangle Fill="#1769E0" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Best" Margin="0,0,16,0" />
                        <Rectangle Fill="#D94B41" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Average" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="FitnessCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="FitnessCanvas_SizeChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
