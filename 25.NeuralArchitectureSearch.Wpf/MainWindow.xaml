<Window x:Class="_25.NeuralArchitectureSearch.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neural Architecture Search With GA.Core"
        Height="780"
        Width="1240"
        MinHeight="680"
        MinWidth="1060"
        Background="#F6F7F9"
        WindowState="Maximized">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#20242A" /></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="12,6" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Neural Architecture Search" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="GA searches the policy network shape and its weights for lunar landing" Foreground="#59616D" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Solver parameters" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Text="Population size" FontWeight="SemiBold" />
                <TextBox x:Name="PopulationSizeTextBox" Text="360" Margin="0,6,0,14" />

                <TextBlock Text="Maximum generations" FontWeight="SemiBold" />
                <TextBox x:Name="MaxGenerationsTextBox" Text="1000" Margin="0,6,0,14" />

                <TextBlock Text="Tournament size" FontWeight="SemiBold" />
                <TextBox x:Name="TournamentSizeTextBox" Text="5" Margin="0,6,0,14" />

                <TextBlock Text="Elitism rate" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="ElitismRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="ElitismRateSlider" Minimum="0.01" Maximum="0.35" Value="0.16" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Text="Mutation rate" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="MutationRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="MutationRateSlider" Minimum="0.02" Maximum="0.70" Value="0.22" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Text="Generation delay" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,18">
                    <TextBlock x:Name="DelayTextBlock" DockPanel.Dock="Right" Width="62" TextAlignment="Right" />
                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="80" Value="4" TickFrequency="1" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <Border Background="#F4F7FB" BorderBrush="#DDE5EF" BorderThickness="1" Padding="10">
                    <TextBlock Text="Search space&#x0a;Hidden layers: 1 or 2&#x0a;Neurons/layer: 4 to 12&#x0a;Activation: tanh&#x0a;Outputs: main, left, right thrust"
                               FontFamily="Consolas"
                               Foreground="#59616D"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18" Margin="0,0,10,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Policy simulation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="best architecture in flight" DockPanel.Dock="Right" Foreground="#59616D" />
                    </DockPanel>
                    <Canvas x:Name="SimulationCanvas" Grid.Row="1" Background="#0B1020" SizeChanged="SimulationCanvas_SizeChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Best network" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="NetworkCaptionTextBlock" Text="architecture genes" DockPanel.Dock="Right" Foreground="#59616D" />
                    </DockPanel>
                    <Canvas x:Name="NetworkCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="NetworkCanvas_SizeChanged" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Population preview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="PopulationListBox" Grid.Row="1" FontFamily="Consolas" BorderBrush="#E5E8EC" Background="#FBFCFD" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Current state" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="Generation" Foreground="#59616D" />
                <TextBlock x:Name="GenerationTextBlock" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Fitness penalty" Foreground="#59616D" />
                <TextBlock x:Name="BestFitnessTextBlock" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Landing score" Foreground="#59616D" />
                <TextBlock x:Name="LandingScoreTextBlock" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Architecture" Foreground="#59616D" />
                <TextBlock x:Name="ArchitectureTextBlock" Text="-" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />

                <TextBlock Text="Final state" Foreground="#59616D" />
                <TextBlock x:Name="FinalStateTextBlock" Text="-" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />

                <TextBlock Text="Status" Foreground="#59616D" />
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,18" />

                <TextBlock Text="Representation" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Gene 0 = layer count&#x0a;Gene 1 = hidden layer 1 size&#x0a;Gene 2 = hidden layer 2 size&#x0a;Other genes = reusable weights&#x0a;Fitness = landing penalty + model cost"
                           FontFamily="Consolas"
                           Foreground="#59616D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Fitness over generations" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Rectangle Fill="#1769E0" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Best" Margin="0,0,16,0" />
                        <Rectangle Fill="#D94B41" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Average" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="FitnessCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="FitnessCanvas_SizeChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
