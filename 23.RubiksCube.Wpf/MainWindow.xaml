<Window x:Class="_23.RubiksCube.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rubik's Cube With GA.Core"
        Height="800"
        Width="1280"
        MinHeight="700"
        MinWidth="1100"
        WindowState="Maximized"
        Background="#F6F7F9">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#20242A" /></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="12,6" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
        <Style TargetType="TextBox"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="8,4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Rubik's Cube Solver" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Chromosome stores cube moves; the 3D cube can be rotated with the mouse" Foreground="#59616D" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ScrambleButton" Content="New Scramble" Click="ScrambleButton_Click" />
                <Button x:Name="StartButton" Content="Start GA" Click="StartButton_Click" />
                <Button x:Name="InverseButton" Content="Show Inverse" Click="InverseButton_Click" />
                <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False" />
                <Button x:Name="ResetViewButton" Content="Reset View" Click="ResetViewButton_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Solver parameters" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Text="Scramble depth" FontWeight="SemiBold" />
                <TextBox x:Name="ScrambleDepthTextBox" Text="5" Margin="0,6,0,14" />

                <TextBlock Text="Solution move count" FontWeight="SemiBold" />
                <TextBox x:Name="MoveCountTextBox" Text="9" Margin="0,6,0,14" />

                <TextBlock Text="Population size" FontWeight="SemiBold" />
                <TextBox x:Name="PopulationSizeTextBox" Text="100" Margin="0,6,0,14" />

                <TextBlock Text="Maximum generations" FontWeight="SemiBold" />
                <TextBox x:Name="MaxGenerationsTextBox" Text="1500" Margin="0,6,0,14" />

                <TextBlock Text="Tournament size" FontWeight="SemiBold" />
                <TextBox x:Name="TournamentSizeTextBox" Text="5" Margin="0,6,0,14" />

                <TextBlock Text="Elitism rate" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="ElitismRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="ElitismRateSlider" Minimum="0.01" Maximum="0.40" Value="0.18" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Text="Mutation rate" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="MutationRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="MutationRateSlider" Minimum="0" Maximum="0.80" Value="0.22" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Text="Generation delay" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock x:Name="DelayTextBlock" DockPanel.Dock="Right" Width="62" TextAlignment="Right" />
                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="100" Value="6" TickFrequency="1" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18" Margin="14,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="3D cube viewer" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="drag to rotate" DockPanel.Dock="Right" Foreground="#59616D" />
                </DockPanel>
                <Border Grid.Row="1" Background="#D1D5DB" ClipToBounds="True">
                    <Viewport3D x:Name="CubeViewport"
                                ClipToBounds="True"
                                MouseDown="CubeViewport_MouseDown"
                                MouseMove="CubeViewport_MouseMove"
                                MouseUp="CubeViewport_MouseUp"
                                MouseWheel="CubeViewport_MouseWheel" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Current state" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="Generation" Foreground="#59616D" />
                <TextBlock x:Name="GenerationTextBlock" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Misplaced stickers" Foreground="#59616D" />
                <TextBlock x:Name="BestFitnessTextBlock" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Scramble" Foreground="#59616D" />
                <TextBlock x:Name="ScrambleTextBlock" Text="-" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />

                <TextBlock Text="Best moves" Foreground="#59616D" />
                <TextBlock x:Name="BestMovesTextBlock" Text="-" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />

                <TextBlock Text="Status" Foreground="#59616D" />
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,18" />

                <TextBlock Text="Representation" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Gene = cube move&#x0a;Moves = U,D,L,R,F,B and inverse&#x0a;Fitness = sticker mismatch&#x0a;Goal = solved cube"
                           FontFamily="Consolas"
                           Foreground="#59616D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Fitness over generations" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Rectangle Fill="#1769E0" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Best" Margin="0,0,16,0" />
                        <Rectangle Fill="#D94B41" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Average" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="FitnessCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="FitnessCanvas_SizeChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
