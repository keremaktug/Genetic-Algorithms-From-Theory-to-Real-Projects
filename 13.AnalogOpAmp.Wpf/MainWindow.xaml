<Window x:Class="_13.AnalogOpAmp.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analog Op-Amp With GA.Core"
        Height="760"
        Width="1180"
        MinHeight="660"
        MinWidth="1020"
        Background="#F6F7F9"
        WindowState="Maximized">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20242A" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Analog Op-Amp Gain" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Choose feedback resistors from a catalog to match a non-inverting amplifier gain" Foreground="#59616D" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Problem and solver" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <TextBlock Text="Target voltage gain" FontWeight="SemiBold" />
                    <TextBox x:Name="TargetGainTextBox" Text="10" Margin="0,6,0,14" />

                    <TextBlock Text="Population size" FontWeight="SemiBold" />
                    <TextBox x:Name="PopulationSizeTextBox" Text="300" Margin="0,6,0,14" />

                    <TextBlock Text="Maximum generations" FontWeight="SemiBold" />
                    <TextBox x:Name="MaxGenerationsTextBox" Text="300" Margin="0,6,0,14" />

                    <TextBlock Text="Tournament size" FontWeight="SemiBold" />
                    <TextBox x:Name="TournamentSizeTextBox" Text="3" Margin="0,6,0,14" />

                    <TextBlock Text="Elitism rate" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,14">
                        <TextBlock x:Name="ElitismRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="ElitismRateSlider" Minimum="0.01" Maximum="0.40" Value="0.12" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                    </DockPanel>

                    <TextBlock Text="Mutation rate" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,14">
                        <TextBlock x:Name="MutationRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                        <Slider x:Name="MutationRateSlider" Minimum="0" Maximum="0.60" Value="0.16" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                    </DockPanel>

                    <TextBlock Text="Generation delay" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock x:Name="DelayTextBlock" DockPanel.Dock="Right" Width="62" TextAlignment="Right" />
                        <Slider x:Name="DelaySlider" Minimum="0" Maximum="100" Value="8" TickFrequency="1" ValueChanged="ParameterSlider_ValueChanged" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Transfer curve" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Canvas x:Name="TransferCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="TransferCanvas_SizeChanged" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Population preview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="PopulationListBox" Grid.Row="1" FontFamily="Consolas" BorderBrush="#E5E8EC" Background="#FBFCFD" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Current state" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="Generation" Foreground="#59616D" />
                <TextBlock x:Name="GenerationTextBlock" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Fitness" Foreground="#59616D" />
                <TextBlock x:Name="BestFitnessTextBlock" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Gain" Foreground="#59616D" />
                <TextBlock x:Name="GainTextBlock" Text="-" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Rg" Foreground="#59616D" />
                <TextBlock x:Name="RgTextBlock" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Rf" Foreground="#59616D" />
                <TextBlock x:Name="RfTextBlock" Text="-" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Status" Foreground="#59616D" />
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,18" />

                <TextBlock Text="Representation" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Gene 0 = Rg index&#x0a;Gene 1 = Rf index&#x0a;Gain = 1 + Rf/Rg&#x0a;Goal = minimize gain error"
                           FontFamily="Consolas"
                           Foreground="#59616D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Fitness over generations" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Rectangle Fill="#1769E0" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Best" Margin="0,0,16,0" />
                        <Rectangle Fill="#D94B41" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Average" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="FitnessCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="FitnessCanvas_SizeChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
