<Window x:Class="_07.Knapsack.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knapsack With GA.Core"
        Height="760"
        Width="1180"
        MinHeight="660"
        MinWidth="1020"
        Background="#F6F7F9"
        WindowState="Maximized">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#20242A" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="#C7CDD6" />
            <Setter Property="Background" Value="#EEF1F4" />
            <Setter Property="Foreground" Value="#1F8A5B" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" LastChildFill="False" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Knapsack Problem" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Binary chromosome: each gene decides whether an item goes into the bag" Foreground="#59616D" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartButton" Content="Start" Click="StartButton_Click" />
                <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="Reset" Click="ResetButton_Click" Margin="0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Solver parameters" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Text="Population size" FontWeight="SemiBold" />
                <TextBox x:Name="PopulationSizeTextBox" Text="500" Margin="0,6,0,14" />

                <TextBlock Text="Maximum generations" FontWeight="SemiBold" />
                <TextBox x:Name="MaxGenerationsTextBox" Text="500" Margin="0,6,0,14" />

                <TextBlock Text="Tournament size" FontWeight="SemiBold" />
                <TextBox x:Name="TournamentSizeTextBox" Text="4" Margin="0,6,0,14" />

                <TextBlock Text="Elitism rate" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="ElitismRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="ElitismRateSlider" Minimum="0.01" Maximum="0.40" Value="0.12" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Text="Mutation rate" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="MutationRateTextBlock" DockPanel.Dock="Right" Width="48" TextAlignment="Right" />
                    <Slider x:Name="MutationRateSlider" Minimum="0" Maximum="0.30" Value="0.04" TickFrequency="0.01" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>

                <TextBlock Text="Generation delay" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock x:Name="DelayTextBlock" DockPanel.Dock="Right" Width="62" TextAlignment="Right" />
                    <Slider x:Name="DelaySlider" Minimum="0" Maximum="100" Value="8" TickFrequency="1" ValueChanged="ParameterSlider_ValueChanged" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="170" />
            </Grid.RowDefinitions>

            <Border Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Items" FontSize="18" FontWeight="SemiBold" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Background="#E7F5EE" BorderBrush="#77B99A" BorderThickness="1" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="Selected" Margin="0,0,16,0" />
                            <Border Background="#F1F3F6" BorderBrush="#C9D0D9" BorderThickness="1" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="Not selected" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                        <WrapPanel x:Name="ItemsWrapPanel" />
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#D7DCE2" BorderThickness="1" Background="#FBFCFD" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Backpack" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="CapacityPercentTextBlock" DockPanel.Dock="Right" Text="0%" FontSize="16" FontWeight="SemiBold" />
                            </DockPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <ProgressBar x:Name="CapacityProgressBar" Minimum="0" Maximum="35" Value="0" />
                                <TextBlock x:Name="CapacityBarTextBlock"
                                           Text="0 / 35 kg"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="BackpackWrapPanel" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Population preview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="PopulationListBox" Grid.Row="1" FontFamily="Consolas" BorderBrush="#E5E8EC" Background="#FBFCFD" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Current state" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="Generation" Foreground="#59616D" />
                <TextBlock x:Name="GenerationTextBlock" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Best value" Foreground="#59616D" />
                <TextBlock x:Name="BestFitnessTextBlock" Text="-" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Total weight" Foreground="#59616D" />
                <TextBlock x:Name="WeightTextBlock" Text="-" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Remaining capacity" Foreground="#59616D" />
                <TextBlock x:Name="RemainingCapacityTextBlock" Text="-" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,12" />

                <TextBlock Text="Selected items" Foreground="#59616D" />
                <TextBlock x:Name="SelectedItemsTextBlock" Text="-" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />

                <TextBlock Text="Chromosome" Foreground="#59616D" />
                <TextBlock x:Name="ChromosomeTextBlock" Text="-" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" />

                <TextBlock Text="Status" Foreground="#59616D" />
                <TextBlock x:Name="StatusTextBlock" Text="Ready" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,18" />

                <TextBlock Text="Representation" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Gene = 0 or 1&#x0a;1 means item is selected&#x0a;Goal = maximize value&#x0a;Over capacity fitness = 0"
                           FontFamily="Consolas"
                           Foreground="#59616D"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" BorderBrush="#D7DCE2" BorderThickness="1" Padding="16" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Fitness over generations" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Rectangle Fill="#1769E0" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Best" Margin="0,0,16,0" />
                        <Rectangle Fill="#D94B41" Width="12" Height="12" Margin="0,0,6,0" />
                        <TextBlock Text="Average" />
                    </StackPanel>
                </DockPanel>
                <Canvas x:Name="FitnessCanvas" Grid.Row="1" Background="#FBFCFD" SizeChanged="FitnessCanvas_SizeChanged" />
            </Grid>
        </Border>
    </Grid>
</Window>
